# FastAPI Backend URL (Authoritative Core)
NEXT_PUBLIC_BACKEND_URL="http://127.0.0.1:8000"
BACKEND_URL="http://127.0.0.1:8000"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication Secret (Must be set in production)
JWT_SECRET="your-secure-jwt-secret-for-production"

# Database URL for Prisma (SQLite or PostgreSQL)
DATABASE_URL="file:./dev.db"

# Optional LLM Advisory Key (Never commit real keys)
ANTHROPIC_API_KEY="your-anthropic-api-key"
